# DTFHN Environment Configuration

# Required: Anthropic API key for Claude script generation
ANTHROPIC_API_KEY=sk-ant-api03-...

# Optional: Cloudflare R2 credentials for hosting
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=

# Optional: Character selection (default: jack)
# Options: jack, forbin, carlin, stephen_fry, philip_fry, noel, scarjo, lynch
CHARACTER=jack
